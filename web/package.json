{
  "name": "gdgoc-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc && tsc --project tsconfig.node.json",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:golden": "vitest run tests/golden",
    "test:golden:update": "vitest run tests/golden -u",
    "test:e2e": "playwright test --pass-with-no-tests",
    "deploy": "pnpm build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply gdgoc-wiki-production-db --local",
    "migrate:remote": "wrangler d1 migrations apply gdgoc-wiki-production-db --remote"
  },
  "dependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.48.0",
    "@react-router/cloudflare": "^7.14.0",
    "@tiptap/core": "^3.22.2",
    "@tiptap/extension-image": "^3.22.2",
    "@tiptap/extension-link": "^3.22.2",
    "@tiptap/extension-table": "^3.22.2",
    "@tiptap/extension-table-cell": "^3.22.2",
    "@tiptap/extension-table-header": "^3.22.2",
    "@tiptap/extension-table-row": "^3.22.2",
    "@tiptap/pm": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "better-auth": "^1.5.6",
    "diff": "^8.0.4",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.45.2",
    "emoji-picker-react": "^4.18.0",
    "firebase": "^12.11.0",
    "i18next": "^26.0.3",
    "lib0": "^0.2.117",
    "lucide-react": "^1.7.0",
    "marked": "^17.0.6",
    "md-editor-rt": "^6.4.1",
    "mermaid": "^11.14.0",
    "nanoid": "^5.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.2",
    "react-router": "^7.14.0",
    "remix-i18next": "^7.4.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@cloudflare/puppeteer": "^1.0.6",
    "@cloudflare/vite-plugin": "^1.31.0",
    "@cloudflare/workers-types": "^4.20260405.1",
    "@playwright/test": "^1.59.1",
    "@react-router/dev": "^7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.80.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "supportedArchitectures": {
      "cpu": ["x64", "arm64"],
      "os": ["darwin", "linux"]
    },
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp", "workerd"]
  }
}
