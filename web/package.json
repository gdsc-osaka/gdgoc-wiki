{
  "name": "gdgoc-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc && tsc --project tsconfig.node.json",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:golden": "vitest run tests/golden",
    "test:golden:update": "vitest run tests/golden -u",
    "test:e2e": "playwright test --pass-with-no-tests",
    "deploy": "pnpm build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply gdgoc-wiki-production-db --local",
    "migrate:remote": "wrangler d1 migrations apply gdgoc-wiki-production-db --remote"
  },
  "dependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.7.0",
    "@react-router/cloudflare": "^7.16.0",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "better-auth": "^1.6.13",
    "diff": "^9.0.0",
    "dompurify": "^3.4.7",
    "drizzle-orm": "^0.45.2",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.14.0",
    "i18next": "^26.3.0",
    "lib0": "^0.2.117",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.4",
    "md-editor-rt": "^6.5.1",
    "mermaid": "^11.15.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router": "^7.16.0",
    "remix-i18next": "^7.5.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "^4.20260531.1",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "supportedArchitectures": {
      "cpu": ["x64", "arm64"],
      "os": ["darwin", "linux"]
    },
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp", "workerd"]
  }
}
